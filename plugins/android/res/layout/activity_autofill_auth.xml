<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAutofill="noExcludeDescendants"
    tools:targetApi="o"
    android:background="#99000000"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/fuin_autofill_item_bg"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/auth_dialog_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fuin Kasasını Doğrula"
                    android:textColor="#E8E2D8"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/auth_dialog_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Şifreyi doldurmak için biyometrik doğrulama veya ekran kilidinizi kullanın"
                    android:textColor="#A69D92"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ListView
            android:id="@+id/auth_picker_list"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:divider="#3D3830"
            android:dividerHeight="1dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/auth_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C88040"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btn_cancel_auth"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="İptal"
                android:textAllCaps="false"
                android:textColor="#A69D92"
                android:background="@android:color/transparent"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_confirm_auth"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Doğrula"
                android:textAllCaps="false"
                android:textColor="#1A1816"
                android:textStyle="bold"
                android:background="#5A9A6E"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
